{
  "expo": {
    "name": "Money Cells",
    "slug": "money-cells",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080e09"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moneycells.app",
      "buildNumber": "19",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "NSCameraUsageDescription": "Cellie uses your camera to analyse items you want to buy and give you a 'worth it?' verdict.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en"
        ],
        "NSFaceIDUsageDescription": "Use Face ID to unlock the parent dashboard.",
        "LSApplicationQueriesSchemes": [
          "itms-apps"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080e09"
      },
      "package": "com.moneycells.app",
      "versionCode": 2,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-secure-store",
      "expo-camera"
    ],
    "scheme": "moneycells",
    "extra": {
      "eas": {
        "projectId": "fe64a96e-768b-463f-9af6-bfcf02e4a5cb"
      }
    },
    "owner": "sandeepskumar07"
  }
}